# "sqlite" (default, zero-config) or "mysql" (MariaDB-compatible)
DB_PROVIDER=sqlite

# --- DATABASE_URL ---
# Docker with sqlite (default compose):     file:./data/anisync.db
#   (that path is bind-mounted to ./db on the host, see docker-compose.yml —
#   get this wrong and your data won't survive a rebuild)
# Docker with MariaDB (--profile mariadb):   mysql://anisync:${MARIADB_PASSWORD}@db:3306/anisync
# Local (non-Docker) dev with sqlite:        file:./dev.db
DATABASE_URL=file:./data/anisync.db

# Only used by the `db` service in docker-compose.yml when running with
# --profile mariadb; ignored otherwise.
MARIADB_PASSWORD=change-me
MARIADB_ROOT_PASSWORD=change-me-too

# Long random string used to sign session JWTs. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string

# Public origin of this deployment, used to build OAuth redirect URIs
# (e.g. https://anisync.example.com). Defaults to http://localhost:3000.
APP_URL=http://localhost:3000

# Provider API credentials (MAL/AniList/Shikimori client id+secret) are NOT
# set via env — the first registered user becomes admin and configures them
# in Admin > Integrations from the web UI.
