// This file is a template. Do not run `prisma` commands against it directly.
// Run `npm run db:select` (reads DB_PROVIDER env: "sqlite" | "mysql") to render
// this into prisma/schema.prisma before generate/migrate/dev.

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "__PROVIDER__"
  url      = env("DATABASE_URL")
}

// SQLite has no native enum type and Prisma's sqlite connector does not
// support the `enum` schema construct, so these are plain strings validated
// against src/lib/constants.ts (SERVICES / RATING_ROUND_MODES) in app code,
// kept identical across the sqlite/mysql schema variants.

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  isAdmin      Boolean  @default(false)
  createdAt    DateTime @default(now())

  connections ServiceConnection[]
  syncConfig  SyncConfig?
  syncRuns    SyncRun[]
}

model ServiceConnection {
  id               String    @id @default(cuid())
  userId           String
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  service          String
  accessToken      String    /*LONGTEXT*/
  refreshToken     String?   /*LONGTEXT*/
  tokenExpiresAt   DateTime?
  externalUserId   String?
  externalUsername String?
  scoreFormat      String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@unique([userId, service])
}

model SyncConfig {
  id              String   @id @default(cuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  sourceService   String?
  autoSyncEnabled Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  destinations SyncDestinationConfig[]
}

model SyncDestinationConfig {
  id                String          @id @default(cuid())
  syncConfigId      String
  syncConfig        SyncConfig      @relation(fields: [syncConfigId], references: [id], onDelete: Cascade)
  service           String
  enabled           Boolean         @default(true)
  destructive       Boolean         @default(false)
  importAnime       Boolean         @default(true)
  importManga       Boolean         @default(true)
  importStatus      Boolean         @default(true)
  importProgress    Boolean         @default(true)
  importRatings     Boolean         @default(true)
  ratingRoundMode   String          @default("NEAREST")
  importNotes       Boolean         @default(false)
  importCustomLists Boolean         @default(false)
  importStartDate   Boolean         @default(true)
  importFinishDate  Boolean         @default(true)
  importRewatches   Boolean         @default(true)
  importPriority    Boolean         @default(false)

  @@unique([syncConfigId, service])
}

model SyncRun {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  trigger      String    @default("manual")
  startedAt    DateTime  @default(now())
  finishedAt   DateTime?
  status       String    @default("running")
  errorMessage String?   /*LONGTEXT*/

  results SyncRunResult[]
}

model SyncRunResult {
  id                 String   @id @default(cuid())
  syncRunId          String
  syncRun            SyncRun  @relation(fields: [syncRunId], references: [id], onDelete: Cascade)
  destinationService String
  created            Int      @default(0)
  updated            Int      @default(0)
  unchanged          Int      @default(0)
  skipped            Int      @default(0)
  skippedEntries     String? /*LONGTEXT*/

  @@unique([syncRunId, destinationService])
}

model AppSetting {
  key   String @id
  value String
}
